  ],
  "demo": {
    "title": "強い輪郭と平坦部で筆の長さを比べる",
    "caption": "候補900個、最大線長24px（最小6px）、勾配基準180、線幅3、シード42が初期値です。勾配の向きはDay 20と同じ向き、勾配強度で線長を調整します。元画像・候補数・長さ・基準・線幅・色・シードを変えられます。",
    "html": "<!doctype html><html lang=\"ja\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>*{box-sizing:border-box}body{margin:0;padding:12px;background:#f3f0e8;color:#28373b;font:15px/1.5 system-ui,sans-serif}.controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(138px,1fr));gap:8px}label{display:grid;gap:4px;font-size:13px}select,input,button{min-height:44px;padding:7px 9px;border:1px solid #c7c2b8;border-radius:7px;background:white;color:inherit;font:inherit}.check{display:flex;align-items:center;gap:8px}.check input{width:22px;height:22px}.views{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.panel{min-width:0}.panel strong{display:block;margin-bottom:5px;font-size:13px}canvas{width:100%;display:block;aspect-ratio:1.45;border:1px solid #cfc8bb;background:#fff}.note{min-height:1.6em;margin:7px 0;color:#516367;font-size:13px}@media(max-width:560px){body{padding:8px}.controls{grid-template-columns:repeat(2,minmax(0,1fr))}.views{grid-template-columns:1fr}canvas{aspect-ratio:1.5}}</style></head><body><div class=\"controls\"><label>シード<input id=\"seed\" type=\"number\" value=\"42\"></label><label>候補数<select id=\"count\"><option>400</option><option selected>900</option><option>1800</option><option>3000</option></select></label><label>元画像<select id=\"source\"><option value=\"wave\">波と水面</option><option value=\"land\">丘と空</option><option value=\"flower\">花</option></select></label><label>最大線長<select id=\"maxLength\"><option value=\"12\">12 px</option><option value=\"24\" selected>24 px</option><option value=\"36\">36 px</option></select></label><label>勾配の基準<select id=\"reference\"><option value=\"90\">90</option><option value=\"180\" selected>180</option><option value=\"360\">360</option></select></label><label>線幅<select id=\"width\"><option>1</option><option selected>3</option><option>5</option></select></label><label>色<select id=\"color\"><option value=\"sample\" selected>画素の色</option><option value=\"gray\">白黒</option><option value=\"warm\">朱色</option></select></label><label class=\"check\"><input id=\"guides\" type=\"checkbox\">勾配の向きを表示</label><button id=\"redraw\" type=\"button\">描き直す</button><button id=\"newseed\" type=\"button\">別のシード</button></div><div class=\"views\"><div class=\"panel\"><strong>元画像 <span id=\"guideLabel\"></span></strong><canvas id=\"sourceCanvas\" role=\"img\" aria-label=\"元画像と明るくなる勾配の矢印\"></canvas></div><div class=\"panel\"><strong>勾配の強さで線長を変えた結果</strong><canvas id=\"resultCanvas\" role=\"img\" aria-label=\"明暗差の強い場所は短く平坦な場所は長く描く画像デモ\"></canvas></div></div><p id=\"note\" class=\"note\" aria-live=\"polite\"></p><script>\nconst src=document.querySelector(\"#sourceCanvas\"),sc=src.getContext(\"2d\"),out=document.querySelector(\"#resultCanvas\"),ctx=out.getContext(\"2d\");\nfunction grayAt(data,w,h,x,y){x=Math.max(0,Math.min(w-1,x));y=Math.max(0,Math.min(h-1,y));const i=(y*w+x)*4;return .299*data[i]+.587*data[i+1]+.114*data[i+2]}\nfunction makeSource(w,h,mode){sc.fillStyle=\"#f7f2e8\";sc.fillRect(0,0,w,h);if(mode===\"wave\"){sc.fillStyle=\"#94c5d0\";sc.fillRect(0,h*.43,w,h*.57);for(let j=0;j<5;j++){sc.beginPath();const base=h*(.5+j*.105);sc.moveTo(0,base);for(let x=0;x<=w;x+=4)sc.lineTo(x,base+Math.sin(x*.025+j*1.2)*h*.03);sc.lineTo(w,h);sc.lineTo(0,h);sc.closePath();sc.fillStyle=[\"#82bac5\",\"#649faf\",\"#4e8398\",\"#3b667d\",\"#2c4e64\"][j];sc.fill()}}else if(mode===\"land\"){sc.fillStyle=\"#d9e7df\";sc.fillRect(0,0,w,h*.62);sc.fillStyle=\"#789288\";sc.beginPath();sc.moveTo(0,h*.66);sc.lineTo(w*.28,h*.28);sc.lineTo(w*.52,h*.63);sc.lineTo(w*.73,h*.35);sc.lineTo(w,h*.67);sc.lineTo(w,h);sc.lineTo(0,h);sc.fill();sc.fillStyle=\"#385e61\";sc.beginPath();sc.moveTo(0,h*.82);sc.quadraticCurveTo(w*.35,h*.57,w*.6,h*.83);sc.quadraticCurveTo(w*.82,h*.98,w,h*.7);sc.lineTo(w,h);sc.lineTo(0,h);sc.fill()}else{sc.fillStyle=\"#eadbbf\";sc.fillRect(0,0,w,h);for(let i=0;i<10;i++){const a=i*Math.PI/5;sc.save();sc.translate(w*.5,h*.5);sc.rotate(a);sc.fillStyle=i%2?\"#d76f59\":\"#eea761\";sc.beginPath();sc.ellipse(0,-h*.2,w*.12,h*.24,0,0,Math.PI*2);sc.fill();sc.restore()}sc.fillStyle=\"#66503b\";sc.beginPath();sc.arc(w*.5,h*.5,Math.min(w,h)*.105,0,Math.PI*2);sc.fill();sc.fillStyle=\"#6b8659\";sc.fillRect(w*.48,h*.72,w*.04,h*.28)}}\nfunction draw(){const a=src.getBoundingClientRect(),d=Math.min(devicePixelRatio||1,2),w=Math.max(1,a.width),h=Math.max(1,a.height);src.width=out.width=Math.round(w*d);src.height=out.height=Math.round(h*d);sc.setTransform(d,0,0,d,0,0);ctx.setTransform(d,0,0,d,0,0);makeSource(w,h,document.querySelector(\"#source\").value);const pixels=sc.getImageData(0,0,src.width,src.height).data;const show=document.querySelector(\"#guides\").checked;\nif(show){for(let y=18;y<h;y+=34)for(let x=18;x<w;x+=34){const ix=Math.floor(x*d),iy=Math.floor(y*d),gx=grayAt(pixels,src.width,src.height,ix+1,iy)-grayAt(pixels,src.width,src.height,ix-1,iy),gy=grayAt(pixels,src.width,src.height,ix,iy+1)-grayAt(pixels,src.width,src.height,ix,iy-1),m=Math.hypot(gx,gy);if(m<4)continue;const an=Math.atan2(gy,gx),len=9;sc.strokeStyle=\"rgba(30,48,53,.78)\";sc.lineWidth=1.3;sc.beginPath();sc.moveTo(x-Math.cos(an)*len/2,y-Math.sin(an)*len/2);sc.lineTo(x+Math.cos(an)*len/2,y+Math.sin(an)*len/2);sc.stroke();sc.beginPath();sc.moveTo(x+Math.cos(an)*len/2,y+Math.sin(an)*len/2);sc.lineTo(x+Math.cos(an)*len/2-Math.cos(an-.55)*3,y+Math.sin(an)*len/2-Math.sin(an-.55)*3);sc.stroke()}}\ndocument.querySelector(\"#guideLabel\").textContent=show?\"（矢印は明るくなる向き）\":\"\";ctx.fillStyle=\"#f7f2e8\";ctx.fillRect(0,0,w,h);let seed=Math.floor(Number(document.querySelector(\"#seed\").value)||1);seed=(seed-1)%2147483646+1;function random(){seed=seed*16807%2147483647;return(seed-1)/2147483646}\nconst count=Number(document.querySelector(\"#count\").value),maxLength=Number(document.querySelector(\"#maxLength\").value),minLength=maxLength/4,reference=Number(document.querySelector(\"#reference\").value),lineWidth=Number(document.querySelector(\"#width\").value),colorMode=document.querySelector(\"#color\").value;let kept=0;\nfor(let i=0;i<count;i++){const x=random()*w,y=random()*h,ix=Math.floor(x*d),iy=Math.floor(y*d),k=(iy*src.width+ix)*4,r=pixels[k],g=pixels[k+1],b=pixels[k+2],gray=.299*r+.587*g+.114*b,p=1-gray/255,gx=grayAt(pixels,src.width,src.height,ix+1,iy)-grayAt(pixels,src.width,src.height,ix-1,iy),gy=grayAt(pixels,src.width,src.height,ix,iy+1)-grayAt(pixels,src.width,src.height,ix,iy-1),m=Math.hypot(gx,gy),angle=m<4?0:Math.atan2(gy,gx)+Math.PI/2,strength=Math.min(m/reference,1),length=minLength+(maxLength-minLength)*(1-strength);\nif(random()<p){kept++;let strokeColor;if(colorMode===\"sample\")strokeColor=\"rgb(\"+r+\",\"+g+\",\"+b+\")\";else if(colorMode===\"gray\"){const v=Math.round(gray);strokeColor=\"rgb(\"+v+\",\"+v+\",\"+v+\")\"}else strokeColor=\"#c85c43\";ctx.strokeStyle=strokeColor;ctx.lineWidth=lineWidth;ctx.lineCap=\"round\";ctx.beginPath();ctx.moveTo(x-Math.cos(angle)*length/2,y-Math.sin(angle)*length/2);ctx.lineTo(x+Math.cos(angle)*length/2,y+Math.sin(angle)*length/2);ctx.stroke()}}\ndocument.querySelector(\"#note\").textContent=\"候補 \"+count+\" 個 · 採用 \"+kept+\" 個 · 基準 \"+reference+\" · 線長 \"+minLength+\"〜\"+maxLength+\" px\";}\nfor(const id of [\"seed\",\"count\",\"source\",\"maxLength\",\"reference\",\"width\",\"color\",\"guides\"]){const e=document.querySelector(\"#\"+id);e.addEventListener(\"change\",draw);e.addEventListener(\"input\",draw)}document.querySelector(\"#redraw\").addEventListener(\"click\",draw);document.querySelector(\"#newseed\").addEventListener(\"click\",()=>{const e=document.querySelector(\"#seed\");e.value=String((Number(e.value)||1)+1);draw()});window.addEventListener(\"resize\",draw);window.addEventListener(\"message\",e=>{if(e.data?.type!==\"gal-experiment\")return;for(const c of e.data.controls||[]){const el=document.querySelector(c.selector);if(el){el.value=c.value;el.dispatchEvent(new Event(\"change\"))}}});requestAnimationFrame(draw);\n</script></body></html>"
  },
