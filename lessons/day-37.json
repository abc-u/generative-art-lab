  "demo": {
    "title": "曲線に沿って点を等間隔に置く",
    "caption": "遠心Catmull–Rom曲線を固定し、等しいtと等しい距離を比較します。初期設定はN=5、各区間40分割。アンカー、点数、表の細かさ、点の大きさ・形・色を試せます。",
    "html": "<!doctype html><html lang=\"ja\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>\n*{box-sizing:border-box}body{margin:0;padding:14px;background:#f4f2ea;color:#20343a;font:15px/1.5 system-ui,sans-serif}.controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:10px;margin-bottom:12px}label{display:grid;gap:4px;font-size:13px}select,input,button{min-height:44px;padding:7px;border:1px solid #bac5bf;border-radius:8px;background:#fff;color:#20343a;font:inherit}input[type=range]{padding:0;accent-color:#24776d}.wrap{padding:8px;border:1px solid #d3d8d0;border-radius:10px;background:#fff}.wrap canvas{display:block;width:100%;height:auto;aspect-ratio:13/7.5;border-radius:6px;touch-action:none}.actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:10px}.actions button{cursor:pointer;background:#20343a;color:white}.status{font-size:13px;font-weight:650}.note{font-size:13px;color:#596660;margin:9px 0 0}@media(max-width:560px){body{padding:10px}.controls{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:370px){.controls{grid-template-columns:1fr}}\n</style></head><body>\n<div class=\"controls\">\n<label>点の置き方<select id=\"method\"><option value=\"t\">等しい t</option><option value=\"length\" selected>等しい距離</option></select></label>\n<label>点の数 N <output id=\"nOut\">5</output><input id=\"count\" type=\"range\" min=\"5\" max=\"25\" step=\"2\" value=\"5\"></label>\n<label>表の細かさ（1区間）<output id=\"resOut\">40</output><input id=\"resolution\" type=\"range\" min=\"8\" max=\"80\" step=\"8\" value=\"40\"></label>\n<label>点の大きさ <output id=\"sizeOut\">7 px</output><input id=\"size\" type=\"range\" min=\"3\" max=\"12\" step=\"1\" value=\"7\"></label>\n<label>点の形<select id=\"shape\"><option value=\"circle\">円</option><option value=\"square\">四角</option><option value=\"diamond\">ひし形</option></select></label>\n<label>色<select id=\"palette\"><option value=\"teal\">青緑</option><option value=\"coral\">朱色</option><option value=\"violet\">紫</option></select></label>\n<label>アンカーと補助線<input id=\"guides\" type=\"checkbox\" checked></label>\n</div>\n<div class=\"wrap\"><canvas id=\"canvas\" width=\"520\" height=\"300\" aria-label=\"曲線上にt等間隔または距離等間隔で点を置くデモ\"></canvas></div>\n<div class=\"actions\"><button id=\"reset\" type=\"button\">初期配置に戻す</button><span id=\"status\" class=\"status\" aria-live=\"polite\"></span></div>\n<p class=\"note\">Day 36 の遠心 Catmull–Rom（α=0.5）を使います。点 P₀〜P₄ をドラッグし、等しい t と等しい距離の点の間隔を比べてください。</p>\n<script>\n(function(){\nconst W=520,H=300,canvas=document.getElementById('canvas'),ctx=canvas.getContext('2d');\nconst initial=[{x:35,y:220},{x:115,y:55},{x:210,y:240},{x:300,y:75},{x:485,y:205}];\nlet anchors=initial.map(p=>({x:p.x,y:p.y})),drag=-1,dpr=1;\nconst $=id=>document.getElementById(id),alpha=0.5;\nconst mix=(a,b,u)=>({x:a.x+(b.x-a.x)*u,y:a.y+(b.y-a.y)*u});\nconst gap=(a,b)=>Math.hypot(b.x-a.x,b.y-a.y);\nfunction curveSegment(P0,P1,P2,P3,u){\nconst d0=Math.max(gap(P0,P1)**alpha,1e-4),d1=Math.max(gap(P1,P2)**alpha,1e-4),d2=Math.max(gap(P2,P3)**alpha,1e-4);\nconst t0=0,t1=d0,t2=d0+d1,t3=t2+d2,t=t1+(t2-t1)*u;\nconst A1=mix(P0,P1,(t-t0)/(t1-t0)),A2=mix(P1,P2,(t-t1)/(t2-t1)),A3=mix(P2,P3,(t-t2)/(t3-t2));\nconst B1=mix(A1,A2,(t-t0)/(t2-t0)),B2=mix(A2,A3,(t-t1)/(t3-t1));\nreturn mix(B1,B2,(t-t1)/(t2-t1));\n}\nfunction curveAt(t){\nconst segments=anchors.length-1,i=Math.max(0,Math.min(segments-1,Math.floor(t))),u=Math.max(0,Math.min(1,t-i));\nconst P1=anchors[i],P2=anchors[i+1],P0=i?anchors[i-1]:{x:2*P1.x-P2.x,y:2*P1.y-P2.y},P3=i+2<anchors.length?anchors[i+2]:{x:2*P2.x-P1.x,y:2*P2.y-P1.y};\nreturn curveSegment(P0,P1,P2,P3,u);\n}\nfunction lengthTable(resolution){\nconst table=[{t:0,s:0,p:curveAt(0)}],segments=anchors.length-1,steps=segments*resolution;let total=0,prev=table[0].p;\nfor(let k=1;k<=steps;k++){const t=segments*k/steps,p=curveAt(t);total+=gap(prev,p);table.push({t,s:total,p});prev=p}\nreturn table;\n}\nfunction parameterAtDistance(table,target){\nlet lo=0,hi=table.length-1;while(lo<hi){const mid=Math.floor((lo+hi)/2);if(table[mid].s<target)lo=mid+1;else hi=mid}\nconst b=table[lo],a=table[Math.max(0,lo-1)],f=(target-a.s)/Math.max(1e-9,b.s-a.s);return a.t+(b.t-a.t)*f;\n}\nfunction palette(){return {teal:'#24776d',coral:'#d45f4e',violet:'#7351a8'}[$('palette').value]}\nfunction resize(){dpr=Math.min(window.devicePixelRatio||1,2);canvas.width=W*dpr;canvas.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);draw()}\nfunction draw(){\nif(!ctx)return;ctx.clearRect(0,0,W,H);ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);\nconst resolution=Number($('resolution').value),count=Number($('count').value),table=lengthTable(resolution),length=table.at(-1).s,segments=anchors.length-1;\nctx.beginPath();for(let k=0;k<=segments*resolution;k++){const p=curveAt(k/resolution);if(k===0)ctx.moveTo(p.x,p.y);else ctx.lineTo(p.x,p.y)}\nctx.strokeStyle='#82928c';ctx.lineWidth=3;ctx.lineCap='round';ctx.stroke();\nconst dots=[];for(let i=0;i<count;i++){const f=i/(count-1),t=$('method').value==='t'?f*segments:parameterAtDistance(table,f*length);dots.push(curveAt(t))}\nconst color=palette(),r=Number($('size').value),shape=$('shape').value;\ndots.forEach((p,i)=>{ctx.save();ctx.translate(p.x,p.y);ctx.rotate(shape==='diamond'?Math.PI/4:0);ctx.fillStyle=color;if(shape==='square'||shape==='diamond')ctx.fillRect(-r,-r,2*r,2*r);else{ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.fill()}ctx.restore()});\nif($('guides').checked){anchors.forEach((p,i)=>{ctx.beginPath();ctx.arc(p.x,p.y,12,0,Math.PI*2);ctx.fillStyle='#fff';ctx.fill();ctx.strokeStyle='#354f5a';ctx.lineWidth=2;ctx.stroke();ctx.fillStyle='#20343a';ctx.font='12px system-ui';ctx.fillText('P'+i,p.x+13,p.y-11)})}\nconst gaps=dots.slice(1).map((p,i)=>gap(p,dots[i])),min=Math.min(...gaps),max=Math.max(...gaps);\n$('nOut').textContent=count;$('resOut').textContent=resolution;$('sizeOut').textContent=r+' px';\n$('status').textContent='曲線長の近似 '+Math.round(length)+' px ／ 点間隔 '+Math.round(min)+'〜'+Math.round(max)+' px';\n}\ndocument.querySelectorAll('select,input').forEach(el=>el.addEventListener('input',draw));\n$('reset').addEventListener('click',()=>{anchors=initial.map(p=>({x:p.x,y:p.y}));$('method').value='length';$('count').value='5';$('resolution').value='40';$('size').value='7';$('shape').value='circle';$('palette').value='teal';$('guides').checked=true;draw()});\nfunction xy(e){const r=canvas.getBoundingClientRect();return{x:(e.clientX-r.left)*W/r.width,y:(e.clientY-r.top)*H/r.height}}\ncanvas.addEventListener('pointerdown',e=>{const q=xy(e);let d=22;anchors.forEach((p,i)=>{const n=Math.hypot(q.x-p.x,q.y-p.y);if(n<d){d=n;drag=i}});if(drag>=0){canvas.setPointerCapture(e.pointerId);e.preventDefault()}});\ncanvas.addEventListener('pointermove',e=>{if(drag<0)return;const q=xy(e);anchors[drag]={x:Math.max(8,Math.min(W-8,q.x)),y:Math.max(8,Math.min(H-8,q.y))};draw()});\ncanvas.addEventListener('pointerup',()=>drag=-1);canvas.addEventListener('pointercancel',()=>drag=-1);\nwindow.addEventListener('resize',resize);resize();\n})();\n</script></body></html>"
  },
