  "code": "const N = 5, M = 40; // 点の数、区間あたりの分割数\nconst table = [{ t: 0, s: 0, p: curve(0) }];\nfor (let k = 1; k <= segments * M; k++) {\n  const t = segments * k / (segments * M), p = curve(t);\n  const last = table[table.length - 1];\n  table.push({ t, s: last.s + distance(last.p, p), p });\n}\nconst L = table[table.length - 1].s;\nfor (let i = 0; i < N; i++) {\n  const target = L * i / (N - 1), j = lowerBound(table, target);\n  const a = table[Math.max(0, j - 1)], b = table[j];\n  const f = (target - a.s) / (b.s - a.s);\n  place(curve(a.t + (b.t - a.t) * f));\n}",
